# Server
PORT=3000

# Database (PostgreSQL + PostGIS via Docker)
# Local: docker compose up -d
# Production: update with Hetzner DB credentials
DATABASE_URL=postgresql://citypaths:citypaths_dev@localhost:5432/citypaths

# Authentication
# Dev values below work out of the box (same defaults as docker-compose.yml).
# MUST be replaced with real secrets before any production deployment.
JWT_SECRET=citypaths-dev-jwt-secret-2026
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# OSRM pedestrian routing engine — read in ONE place, config/osrmConfig.js, and
# used by checkpoint detours (utils/osrmClient.js), seed snapping
# (scripts/snap-routes.js) and live AI generation. If unset, the same public
# FOSSGIS foot-profile instance below is used (fine for development).
# Swap for a self-hosted OSRM when one is added — same URL scheme, no trailing slash.
OSRM_URL=https://routing.openstreetmap.de/routed-foot

# ── AI route generation (optional) ───────────────────────────────────────
# OFF by default. The 100-route generated catalogue is seeded into the
# database by `node scripts/seed-ai-routes.js` and needs NO credentials, so
# the app is fully functional with everything below unset — the "create a
# route for me" button is simply not shown (GET /api/routes/ai/status).
#
# Set to "on" to enable live, per-user generation:
AI_ROUTE_GENERATION=off

# Provider: Groq, through its OpenAI-compatible endpoint. Chosen because its
# free tier covers this use (a few thousand tokens per route) and it answers in
# a couple of seconds. Get a key at https://console.groq.com
AI_ROUTE_API_KEY=

# Optional overrides — the defaults below are what the project documents.
# AI_ROUTE_BASE_URL=https://api.groq.com/openai/v1
# AI_ROUTE_MODEL=openai/gpt-oss-120b
# Groq retires model ids on its own schedule; `node scripts/try-ai-provider.js
# --list` shows what it currently serves and warns if the configured id is gone.
