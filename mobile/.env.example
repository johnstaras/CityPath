# Backend API URL
# For Android emulator with adb reverse: http://localhost:3000/api
# For Android emulator without adb reverse: http://10.0.2.2:3000/api
# For physical device on same network: http://YOUR_LAN_IP:3000/api
# For production: https://your-server.com/api
API_URL=http://10.0.2.2:3000/api

# Google OAuth Web Client ID (from Firebase Console → Project Settings → Web
# client). This value is public by design (it also lives in the committed
# google-services.json) — the dev project's ID works out of the box:
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
